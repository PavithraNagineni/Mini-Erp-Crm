# PostgreSQL connection string.
# Local:    postgresql://postgres:password@localhost:5432/mini_erp_crm
# Neon:     postgresql://user:pass@ep-xxxx.neon.tech/mini_erp_crm?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/mini_erp_crm"

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="change-this-to-a-long-random-secret"

# Access token lifetime
JWT_EXPIRES_IN="8h"

# Server port
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN="http://localhost:5173"
